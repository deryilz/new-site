---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

let entries = await getCollection("homepage");
let sortedEntries = entries.sort((a, b) => a.data.index - b.data.index);
let renderedEntries = await Promise.all(
  sortedEntries.map(async entry => {
    let { Content } = await render(entry);
    return { entry, Content };
  })
);
---

<BaseLayout>
	<div class="w3-container w3-pale-red w3-padding-32">
		<div class="w3-panel w3-center">
			<h1 class="w3-jumbo">Derin Eryilmaz</h1>
			<div class="w3-xlarge">I like to generally just mess around</div>
		</div>
		<div class="w3-panel">
			<div class="w3-flex" style="gap: 20px; justify-content: center;">
				<a class="w3-btn w3-large w3-ripple w3-purple" href="/blog">Blog</a>
				<a class="w3-btn w3-large w3-ripple w3-teal" href="https://github.com/deryilz">GitHub</a>
				<a class="w3-btn w3-large w3-ripple w3-pink" href="https://x.com/deryilz">Twitter</a>
			</div>
		</div>
	</div>
	{Array.from({ length: Math.ceil(renderedEntries.length / 2) }, (_, row) => {
		const entries = renderedEntries.slice(row * 2, row * 2 + 2);

		return (
			<div class="w3-row" style="display: flex; flex-wrap: wrap;">
				{entries.map(({ entry, Content }, i) => {
					const color = ["blue", "yellow", "green"][(row * 2 + i) % 3];

					return <div class={`w3-half w3-padding-large w3-pale-${color}`}>
						<h2>{entry.data.title}</h2>
						<Content />
					</div>
				})}
			</div>
		);
	})}
</BaseLayout>
