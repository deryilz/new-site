---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    let posts = await getCollection("blog");
    return posts.map(entry => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

let { entry } = Astro.props;
let { Content } = await render(entry);
---
<BaseLayout title={entry.data.title}>
    <style is:global>
        img, video {
            max-width: 100%;
            height: auto;
            display: block;
        }
        .astro-code {
            padding: 10px;
        }
    </style>
    <article class="w3-panel w3-content" style="max-width: 800px;">
        <div class="w3-row">
            <a href="/" class="w3-button w3-light-gray">Derin Eryilmaz</a>
        </div>
        <h1 class="w3-margin-top w3-margin-bottom">{entry.data.title}</h1>
        <div class="w3-bar">
            {entry.data.tags.map((tag, i) => {
                let color = ["purple", "teal", "pink"][i % 3];
                return <a href={`/tags/${tag}`} class={`w3-btn w3-margin-right w3-ripple w3-tag w3-${color}`}>{tag}</a>;
            })}
        </div>
        <p class="w3-text-grey">{entry.data.date.toLocaleDateString()}</p>
        <hr>
        <div>
            <Content />
        </div>
        <a href="/blog" class="w3-button w3-light-gray w3-margin-bottom w3-margin-top">Other posts</a>
    </article>
</BaseLayout>
